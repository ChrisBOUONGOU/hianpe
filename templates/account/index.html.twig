{% extends 'base.html.twig' %}
{% block title %}Mon compte — Hianpe{% endblock %}
{% block body %}
<style>
.account-page{min-height:100vh;background:#f5f0e6;color:#171714;font-family:Inter,system-ui,sans-serif;padding:36px 16px 70px}.account-wrap{max-width:1050px;margin:auto}.account-nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:42px;gap:16px}.account-nav a{font-weight:800;text-decoration:none;color:inherit}.account-card{background:#fffdf8;border:1px solid #e5ddcf;border-radius:20px;padding:25px;margin:18px 0}.account-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:15px}.account-card h1{font-size:2.4rem;letter-spacing:-.06em;margin:0 0 8px}.account-card h2{font-size:1.25rem;margin:0 0 10px}.muted{color:#6f6b62}.account-button{display:inline-block;border:0;border-radius:999px;background:#171714;color:white;padding:12px 17px;font:inherit;font-weight:800;cursor:pointer;text-decoration:none}.account-button.yellow{background:#f5c542;color:#171714}.account-button.secondary{background:transparent;color:#171714;border:1px solid #d8d0c2}.account-card form{margin-top:18px}.flash{padding:12px 15px;border-radius:10px;margin:10px 0;background:#edf7ed}.flash.error{background:#fff0ed;color:#9c2d1d}.account-top{display:flex;justify-content:space-between;align-items:start;gap:20px;flex-wrap:wrap}.subscription-row{padding:14px 0;border-top:1px solid #eee6d9;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}@media(max-width:600px){.account-card{padding:20px}.account-card h1{font-size:2rem}}
</style>
<div class="account-page"><div class="account-wrap">
<header class="account-nav"><a href="/">← Hianpe</a><form method="post" action="{{ path('app_logout') }}"><button class="account-button secondary" type="submit">Déconnexion</button></form></header>
{% for message in app.flashes('success') %}<div class="flash">{{ message }}</div>{% endfor %}{% for message in app.flashes('info') %}<div class="flash">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}
<section class="account-card account-top"><div><h1>Mon compte</h1><p class="muted">Connecté en tant que {{ app.user.userIdentifier }}</p></div>
{% if subscriptions is not empty %}<form method="post" action="{{ path('stripe_portal') }}"><input type="hidden" name="_token" value="{{ csrf_token('stripe_portal') }}"><button class="account-button secondary" type="submit">Gérer la facturation ↗</button></form>{% endif %}</section>
<h2>Choisir un logiciel</h2><p class="muted">Chaque logiciel possède son propre abonnement : 10 $ CA par mois, avec 7 jours d’essai gratuit. Une carte bancaire est demandée au démarrage. Le paiement commence automatiquement après l’essai, sauf annulation.</p>
<div class="account-grid">{% for key,name in {'stageflow':'StageFlow','afrihospital':'AfriHospital','stockflow':'StockFlow'} %}
<article class="account-card"><h2>{{ name }}</h2><p class="muted">10 $ CA / mois · 7 jours d’essai</p><form method="post" action="{{ path('stripe_checkout',{product:key}) }}"><input type="hidden" name="_token" value="{{ csrf_token('checkout_' ~ key) }}"><button class="account-button yellow" type="submit">Commencer l’essai gratuit</button></form></article>
{% endfor %}</div>
<section class="account-card"><h2>Mes abonnements</h2>{% if subscriptions is empty %}<p class="muted">Aucun abonnement pour le moment.</p>{% else %}{% for subscription in subscriptions %}
<div class="subscription-row"><div><strong>{{ subscription.productKey|capitalize }}</strong><br><span class="muted">{{ subscription.status }}{% if subscription.trialEndsAt %} · Fin de l’essai : {{ subscription.trialEndsAt|date('d/m/Y') }}{% endif %}</span></div><div class="muted">{% if subscription.cancelAtPeriodEnd %}Annulation programmée{% elseif subscription.currentPeriodEndsAt %}Prochaine échéance : {{ subscription.currentPeriodEndsAt|date('d/m/Y') }}{% endif %}</div></div>
{% endfor %}{% endif %}</section><p class="muted">Les paiements sont traités de manière sécurisée par Stripe. Hianpe ne stocke pas les numéros de carte.</p>
</div></div>
{% endblock %}
